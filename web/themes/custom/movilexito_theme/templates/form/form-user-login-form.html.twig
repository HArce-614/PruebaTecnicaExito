{#
/**
 * @file
 * Theme override for the user login form.
 */
#}
{{ attach_library('movilexito_theme/login') }}

<form{{ attributes.addClass('user-login-form') }}>
  <div class="me-login-logo">
    <img src="{{ base_path }}themes/custom/movilexito_theme/images/logo-movil-exito.svg" alt="Logo" />
  </div>

  <div class="me-login-welcome">
    <h2>{{ 'Log in'|t }}</h2>
    <p>{{ 'Enter your credentials to manage orders and account settings'|t }}</p>
  </div>

  {{ form_prefix }}
  {{ form.name }}
  {{ form.pass }}

  <div class="me-password-link">
    <a href="/user/password">{{ 'Forgot your password?'|t }}</a>
  </div>

  {{ form.actions }}
  {{ form_suffix }}
</form>
