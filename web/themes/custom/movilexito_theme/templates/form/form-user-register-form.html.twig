{#
/**
 * @file
 * Theme override for the user register form.
 */
#}
{{ attach_library('movilexito_theme/login') }}

<form{{ attributes.addClass('user-register-form') }}>
  <div class="me-register-logo">
    <img src="{{ base_path }}themes/custom/movilexito_theme/images/logo-movil-exito.svg" alt="Logo" />
  </div>

  <div class="me-register-welcome">
    <h2>{{ 'Create new account'|t }}</h2>
    <p>{{ 'Join us today and start managing your orders'|t }}</p>
  </div>

  {{ form_prefix }}
  {{ form.account.mail }}
  {{ form.account.name }}
  {{ form.pass }}
  {{ form.user_picture }}
  {{ form.contact }}

  {{ form.actions }}
  {{ form_suffix }}
</form>
