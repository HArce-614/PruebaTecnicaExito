<?php

/**
 * @file
 * Functions to support theming in the Móvil Éxito theme.
 */

/**
 * Implements hook_form_FORM_ID_alter() for user_register_form.
 */
function movilexito_theme_form_user_register_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Simplify and improve descriptions for a cleaner look
  $form['account']['mail']['#description'] = t('Usamos esto para enviarte actualizaciones de tu cuenta.');
  $form['account']['name']['#description'] = t('Solo letras, números y puntuación básica.');
  
  // Make descriptions subtle but helpful
  if (isset($form['account']['pass'])) {
    $form['account']['pass']['#description'] = t('Crea una contraseña fuerte para asegurar tu cuenta.');
  }
  
  if (isset($form['user_picture'][0]['#description'])) {
    $form['user_picture'][0]['#description'] = t('Opcional. Las imágenes cuadradas funcionan mejor.');
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function movilexito_theme_form_user_login_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Keep login form descriptions minimal and clear
  if (isset($form['name']['#description'])) {
    unset($form['name']['#description']);
  }
  
  if (isset($form['pass']['#description'])) {
    unset($form['pass']['#description']);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_pass_form.
 */
function movilexito_theme_form_user_pass_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Improve password reset form description
  if (isset($form['name']['#description'])) {
    $form['name']['#description'] = t('Te enviaremos un enlace para restablecer tu contraseña.');
  }
}

/**
 * Implements hook_preprocess_menu() for user menu translation.
 */
function movilexito_theme_preprocess_menu(&$variables) {
  // Translate menu items
  if (isset($variables['items']) && is_array($variables['items'])) {
    foreach ($variables['items'] as &$item) {
      if (isset($item['title'])) {
        // Primary menu translations
        if ($item['title'] == 'Home') {
          $item['title'] = t('Inicio');
        }
        if ($item['title'] == 'Events') {
          $item['title'] = t('Eventos');
        }
        // Secondary menu translations
        if ($item['title'] == 'My account') {
          $item['title'] = t('Mi cuenta');
        }
        if ($item['title'] == 'Log out') {
          $item['title'] = t('Cerrar sesión');
        }
      }
    }
  }
}

