{# web/modules/custom/custom_events/templates/event-card.html.twig #}
{#
/**
 * @file
 * Single event card.
 *
 * Available variables:
 *   - id: integer entity ID.
 *   - title: string.
 *   - description: render array.
 *   - country: string.
 *   - event_date: ISO string Y-m-d\TH:i:s.
 *   - registered_count: integer.
 *   - user_is_registered: boolean.
 *   - user_is_anonymous: boolean.
 *   - register_url: string POST endpoint.
 *   - csrf_token: string.
 */
#}

<article class="ce-card" id="event-card-{{ id }}" aria-labelledby="event-title-{{ id }}">

  <div class="ce-card__accent" aria-hidden="true"></div>

  {% if is_featured %}<div class="ce-card__inner">{% endif %}

  <header class="ce-card__header">
    <h2 class="ce-card__title" id="event-title-{{ id }}">{{ title }}</h2>

    {% if event_date %}
      <time class="ce-card__date" datetime="{{ event_date }}">
        <svg class="ce-card__icon" viewBox="0 0 20 20" aria-hidden="true" width="16" height="16">
          <rect x="2" y="4" width="16" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <path d="M2 8h16" stroke="currentColor" stroke-width="1.5"/>
          <path d="M6 2v4M14 2v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        {{ event_date|date('d M Y, g:i A') }}
      </time>
    {% endif %}

    {% if country %}
      <p class="ce-card__country">
        <svg class="ce-card__icon" viewBox="0 0 20 20" aria-hidden="true" width="16" height="16">
          <path d="M10 2a6 6 0 0 1 6 6c0 4-6 10-6 10S4 12 4 8a6 6 0 0 1 6-6z" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="10" cy="8" r="2" fill="currentColor"/>
        </svg>
        {{ country }}
      </p>
    {% endif %}
  </header>

  {# ── Description excerpt ─────────────────────────────────────────────── #}
  {% if description %}
    <div class="ce-card__description" aria-label="{{ 'Descripción'|t }}">
      {{ description }}
    </div>
  {% endif %}

  {# ── Footer ──────────────────────────────────────────────────────────── #}
  <footer class="ce-card__footer">
    <span class="ce-card__count-badge" id="reg-count-{{ id }}" aria-live="polite">
      <svg class="ce-card__icon" viewBox="0 0 20 20" aria-hidden="true" width="16" height="16">
        <circle cx="8"  cy="7"  r="3" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="14" cy="6"  r="2.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <path d="M2 16c0-3 2.7-5 6-5s6 2 6 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M14 11c2.2.4 4 2 4 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      {%- if registered_count == 1 -%}
        {{ '1 registrado'|t }}
      {%- else -%}
        {{ '@count registrados'|t({'@count': registered_count}) }}
      {%- endif -%}
    </span>

    {% if user_is_anonymous %}
      <a href="{{ path('user.login') }}" class="ce-card__login-link">
        <svg viewBox="0 0 20 20" aria-hidden="true" width="15" height="15" fill="none">
          <path d="M10 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm-7 8a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        {{ 'Inicia sesión para registrarte'|t }}
      </a>
    {% elseif user_is_registered %}
      <span class="ce-card__registered-badge" role="status">
        <svg viewBox="0 0 20 20" aria-hidden="true" width="16" height="16">
          <path d="M4 10l4 4 8-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {{ 'Ya registrado'|t }}
      </span>
    {% else %}
      <div class="ce-card__toast" id="toast-{{ id }}" role="alert" aria-live="assertive" hidden></div>

      <button
        type="button"
        class="ce-card__register-btn js-register-btn"
        data-event-id="{{ id }}"
        data-register-url="{{ register_url }}"
        data-csrf-token="{{ csrf_token }}"
        aria-label="{{ 'Registrarse para @title'|t({'@title': title}) }}"
      >
        <span class="ce-card__btn-text">{{ 'Registrarse'|t }}</span>
        <span class="ce-card__spinner" aria-hidden="true" hidden></span>
      </button>
    {% endif %}
  </footer>

  {% if is_featured %}</div>{% endif %}

</article>
